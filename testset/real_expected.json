{
  "rules": {
    "TTL-1": {
      "topic": "title",
      "kind": "must",
      "title": "Безликое название, обязанности его не раскрывают"
    },
    "TTL-2": {
      "topic": "title",
      "kind": "must",
      "title": "Название и обязанности о разных профессиях"
    },
    "TTL-3": {
      "topic": "title",
      "kind": "must",
      "title": "Несколько разных профессий в названии, обязанности покрывают не все"
    },
    "TTL-4": {
      "topic": "title",
      "kind": "must",
      "title": "Сведения в названии спорят с полем другой темы"
    },
    "DUT-1": {
      "topic": "duties",
      "kind": "must",
      "title": "Только отсылка или заглушка"
    },
    "DUT-2": {
      "topic": "duties",
      "kind": "must",
      "title": "Не задачи: личные качества, реклама, льготы"
    },
    "DUT-3": {
      "topic": "duties",
      "kind": "must",
      "title": "Пусто и в duty, и в skills"
    },
    "DUT-4": {
      "topic": "duties",
      "kind": "must",
      "title": "Только «поручения руководителя»"
    },
    "REQ-1": {
      "topic": "requirements",
      "kind": "skip",
      "title": "Образование не определено ни в поле, ни в тексте"
    },
    "REQ-2": {
      "topic": "requirements",
      "kind": "must",
      "title": "Опыт в поле расходится с определённым числом в тексте"
    },
    "REQ-3": {
      "topic": "requirements",
      "kind": "must",
      "title": "Минимальный уровень образования в поле и тексте разный"
    },
    "REQ-4": {
      "topic": "requirements",
      "kind": "must",
      "title": "Поле qualification спорит с полем опыта"
    },
    "REQ-5": {
      "topic": "requirements",
      "kind": "skip",
      "title": "Размытые формулировки, отраслевые детали"
    },
    "REQ-6": {
      "topic": "requirements",
      "kind": "flag",
      "title": "Регламентированная профессия без требований"
    },
    "REQ-7": {
      "topic": "requirements",
      "kind": "must",
      "title": "Одно требование в двух местах описано противоположно"
    },
    "PAY-1": {
      "topic": "salary",
      "kind": "must",
      "title": "Суммы нет нигде или только отсылка"
    },
    "PAY-2": {
      "topic": "salary",
      "kind": "must",
      "title": "Итоговая сумма в тексте вне допуска от вилки"
    },
    "PAY-3": {
      "topic": "salary",
      "kind": "must",
      "title": "Минимум больше максимума"
    },
    "PAY-4": {
      "topic": "salary",
      "kind": "must",
      "title": "Вилка шире порога без объяснения"
    },
    "PAY-5": {
      "topic": "salary",
      "kind": "must",
      "title": "Единица оплаты неясна"
    },
    "PAY-6": {
      "topic": "salary",
      "kind": "flag",
      "title": "Сумма при неполном времени без доли ставки"
    },
    "PAY-7": {
      "topic": "salary",
      "kind": "skip",
      "title": "Состав оплаты без влияния на сумму, коды премий"
    },
    "SCH-1": {
      "topic": "schedule",
      "kind": "must",
      "title": "Открытый режим без параметров"
    },
    "SCH-2": {
      "topic": "schedule",
      "kind": "must",
      "title": "Режим в поле расходится с текстом"
    },
    "SCH-3": {
      "topic": "schedule",
      "kind": "must",
      "title": "Дневная смена в поле, ночная в тексте (и наоборот)"
    },
    "SCH-4": {
      "topic": "schedule",
      "kind": "must",
      "title": "Два взаимоисключающих графика"
    },
    "SCH-5": {
      "topic": "schedule",
      "kind": "flag",
      "title": "Параметры частичные или даны вариантами"
    },
    "SCH-6": {
      "topic": "schedule",
      "kind": "skip",
      "title": "Закрытый режим без часов"
    },
    "SCH-7": {
      "topic": "schedule",
      "kind": "must",
      "title": "Работа вне графика без частоты и условий"
    },
    "SCH-8": {
      "topic": "schedule",
      "kind": "must",
      "title": "Часы в день не сходятся с заявленной недельной нормой"
    },
    "LOC-1": {
      "topic": "location",
      "kind": "must",
      "title": "Нет населённого пункта"
    },
    "LOC-2": {
      "topic": "location",
      "kind": "must",
      "title": "Адрес и названное в тексте место работы в разных населённых пунктах"
    },
    "LOC-3": {
      "topic": "location",
      "kind": "skip",
      "title": "Разъезды, удалённая работа, несколько адресов"
    },
    "LOC-4": {
      "topic": "location",
      "kind": "must",
      "title": "Внутри строки адреса два разных населённых пункта"
    },
    "LOC-5": {
      "topic": "location",
      "kind": "must",
      "title": "Дистанционная работа и обязательное присутствие в одной вакансии"
    },
    "LOC-6": {
      "topic": "location",
      "kind": "must",
      "title": "Адрес или формат рабочего места отложены до собеседования"
    },
    "LOC-7": {
      "topic": "location",
      "kind": "must",
      "title": "Несколько адресов в разных населённых пунктах без указания основного"
    },
    "EMP-1": {
      "topic": "employment",
      "kind": "must",
      "title": "Поле занятости расходится с объёмом работы"
    },
    "EMP-2": {
      "topic": "employment",
      "kind": "skip",
      "title": "Поля занятости нет"
    },
    "EMP-3": {
      "topic": "employment",
      "kind": "must",
      "title": "Работа на срок, а поле занятости этого не отражает"
    }
  },
