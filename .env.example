# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
# Cloudflare: панель → Workers AI → Use REST API → Create a Workers AI API Token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Необязательно: любой OpenAI-совместимый сервис (движок openai)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
